JWT_SECRET=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=
# Default 512; bilangan bulat antara 64 dan 2048.
# Production saat ini: set 1536 di environment Netlify.
STATE_JSON_LIMIT_KB=512
# Isi origin HTTPS setelah Netlify memberikan URL production, tanpa path atau trailing slash.
CORS_ORIGIN=
INITIAL_ADMIN_USERNAME=ADMIN
INITIAL_ADMIN_PASSWORD=
NODE_ENV=production
## Keep legacy until schema, migration, validation and rollback acceptance are complete.
## normalized-read is frozen read-only; normalized enables operation APIs.
## Must match cashier.control.mode. This file does not change deployment settings.
PERSISTENCE_MODE=legacy
